# GitHub Configuration
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# Required: GitHub Personal Access Token (increases rate limit from 60 to 5000 requests/hour)
# Recommended: Fine-grained token at https://github.com/settings/personal-access-tokens/new
# Select "Public Repositories (read-only)" - no additional permissions needed
GITHUB_TOKEN=

# Comma-separated list of labels (AND logic - issues must have ALL labels)
# Example: sync-to-linear,needs-triage
GITHUB_LABELS=

# Polling interval in minutes
POLL_INTERVAL_MINUTES=5

# Linear Configuration
# Required: Linear API Key - generate at https://linear.app/settings/api
LINEAR_API_KEY=

# Required: Linear Team ID (UUID format, not the team name/key)
# Find via API or GraphQL explorer - it's a UUID like "a1b2c3d4-..."
LINEAR_TEAM_ID=

# Linear sync label name (will be created if it doesn't exist)
LINEAR_SYNC_LABEL=

# Linear workflow states for status transitions
# State to use when an issue has an open PR (default: "In Review")
LINEAR_STATE_IN_REVIEW=In Review

# State to use when a GitHub issue is closed (default: "Done")
LINEAR_STATE_DONE=Done
